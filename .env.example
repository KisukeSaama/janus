# Local development only. Copy to .env and replace every placeholder with a long random
# value; .env is ignored by Git. Production values come from CI variables and Docker secrets.
POSTGRES_DB=janus
POSTGRES_USER=janus
POSTGRES_PASSWORD=replace-with-a-long-random-value
OPENBAO_DEV_ROOT_TOKEN=replace-with-a-long-random-value
JANUS_ADMIN_USERNAME=admin
# At least 8 characters with upper case, lower case and a digit, as below.
# The value shown is still a known placeholder: a production profile refuses to start on it.
JANUS_ADMIN_PASSWORD=Replace-With-A-Long-Random-Value-9!
# Where this account's own expiry notices are sent. Applied while the bootstrap account still
# carries the address the migration wrote; once a real one is set, that one stands.
JANUS_ADMIN_EMAIL=admin@localhost
JANUS_CORS_ORIGINS=http://localhost:5173

# Every throttle and rate limit is keyed on the client address, and that address is read from
# X-Forwarded-For only for hops listed here. Leave it unset unless a reverse proxy sits in front
# of Janus on a public address: the default already lists loopback and the private ranges, which
# is where a containerised nginx or Traefik lives. It is a comma-separated list of CIDR blocks.
#
# The counterpart holds in both directions: a caller reaching Janus from a listed range is
# believed when it names its predecessor. Production keeps the backend on an internal network
# with no published port, so only the proxy can. Development publishes 8080 for debugging, so
# locally an X-Forwarded-For sent by hand is taken at face value — as with the exposed database.
#JANUS_TRUSTED_PROXIES=

# Per-address ceilings, applied before authentication so they also catch callers with no key.
# Zero disables one. The console spends a handful of requests per screen; the gateway allowance
# is the one sized for machines calling in a loop.
JANUS_RATE_LIMIT_ADMIN_PER_MINUTE=300
JANUS_RATE_LIMIT_ADMIN_BURST=60
JANUS_RATE_LIMIT_GATEWAY_PER_MINUTE=1800
JANUS_RATE_LIMIT_GATEWAY_BURST=300

# Set to true only to point a development provider at a host on a private network.
# It disables the SSRF address filtering that protects everything behind Janus.
JANUS_ALLOW_PRIVATE_DESTINATIONS=false

# Expiry notices. Janus sweeps the recorded expiry dates once a day and announces each stage once:
# a quiet notice this many days ahead, an insistent warning nearer, then the day it passes.
JANUS_EXPIRY_CHECK_CRON=0 15 7 * * *
JANUS_EXPIRY_CHECK_ZONE=Europe/Paris
JANUS_EXPIRY_NOTICE_DAYS=30
JANUS_EXPIRY_WARNING_DAYS=7

# The console always shows the announcements. Mail reaches whoever has not opened it, and needs an
# SMTP relay: without SPRING_MAIL_HOST no sender is built and nothing is sent.
JANUS_EXPIRY_EMAIL_ENABLED=false
JANUS_EXPIRY_EMAIL_RECIPIENTS=platform@example.com,security@example.com
JANUS_EXPIRY_EMAIL_FROM=janus@example.com
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=janus
#SPRING_MAIL_PASSWORD=replace-with-a-long-random-value
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
